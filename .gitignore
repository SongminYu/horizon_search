# ---- Data (generated, large, re-creatable) ----

# CORDIS bulk downloads + F&T Portal fetch cache + OpenAlex cache (~400MB, re-downloadable)
pipeline/raw/

# Transient Excel workbooks built by collection scripts; content is captured in horizon.sqlite
pipeline/parsed/
data/

# Master SQLite database (190MB). NOT in git — distributed as a GitHub Release asset
# (tag `data`); see README. Regenerate from raw/ via build_database.py for a full re-collection.
horizon.sqlite

# Webapp static JSON layers (~127MB) — fully derived from horizon.sqlite by export_webapp.py
# (stdlib-only, ~5s). Not tracked; cloners regenerate them. Netlify uploads them at deploy time.
webapp/data/

# ---- Keys and local secrets ----
webapp/apikey.local.js
pipeline/deepseek_api_key.local
pipeline/openai_api_key.local
pipeline/openalex_api_key.local

# ---- Dev-only tooling ----
# Claude Code project instructions (local AI assistant config)
CLAUDE.md

# Internal quality-evaluation scripts used during model selection
pipeline/scripts/eval_*.py

# ---- Build / runtime artifacts ----
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
~$*.xlsx

# ---- Editor / OS ----
.DS_Store
.AppleDouble
._*
*.log
.claude/settings.local.json

